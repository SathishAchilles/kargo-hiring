# Database (self-hosted Supabase in Docker, ~/ws/supabase-project)
# App: transaction pooler :6543 (prepared statements off). Migrations: session pooler :5432.
DATABASE_URL=postgres://postgres.local:<POSTGRES_PASSWORD>@localhost:6543/postgres
DATABASE_MIGRATION_URL=postgres://postgres.local:<POSTGRES_PASSWORD>@localhost:5432/postgres


# AI (evidence extraction, briefs, email drafts)
GEMINI_API_KEY=<key>

# Email
RESEND_API_KEY=<key>
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# redirect (default): every email goes to EMAIL_TEST_TO. live: real recipients (needs a verified domain).
EMAIL_MODE=redirect
EMAIL_TEST_TO=<your Resend account email>
FOUNDER_SIGNATURE=Arjun Mehta, Founder, Kargo

# Founder sign-in. Generate the hash with: npm run hash-passcode -- '<passcode>'
FOUNDER_PASSCODE_HASH=<bcrypt hash>
SESSION_SECRET=<at least 32 random characters>
